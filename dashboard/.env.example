# Copy this file to .env before running "npm run dev".
#
# For Docker Compose:
VITE_ORDER_API_URL=http://localhost:8081
VITE_POSITION_API_URL=http://localhost:8083

# For Kubernetes (Minikube), replace with the URLs from:
#   minikube service order-gateway -n trading-platform --url
#   minikube service position-service -n trading-platform --url